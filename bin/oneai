#!/usr/bin/env bash
# oneai: set up Jarvis (one main Claude Code session) + optional side agents
# (Worktrunk worktrees) for a repository, and create its TUIOS session.
# See `oneai --help`.
set -euo pipefail

ONEAI_VERSION="0.2.0"

# ---------------------------------------------------------------- basics ---

src="$0"
while [ -L "$src" ]; do
  d="$(cd "$(dirname "$src")" && pwd -P)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
SELF="$(cd "$(dirname "$src")" && pwd -P)/$(basename "$src")"
SHARE="${ONEAI_SHARE:-$(dirname "$(dirname "$SELF")")/share/oneai}"
CLAUDE_CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
MARKER="oneai-managed"

DRY=0
YES=0
ATTACH=1

# -- TTY STYLES -- #
# shellcheck disable=SC2034 # shared style block: not every script uses every style
tty_styles() {
  # Colors only when stdout and stderr are terminals and NO_COLOR is not set
  if [[ -t 1 && -t 2 && -z ${NO_COLOR-} ]]; then
    C_RED=$'\033[1;31m' C_GREEN=$'\033[1;32m' C_YELLOW=$'\033[1;33m'
    C_BLUE=$'\033[1;34m' C_PURPLE=$'\033[1;35m' C_CYAN=$'\033[1;36m'
    C_WHITE=$'\033[1;37m' C_GRAY=$'\033[0;90m' C_RESET=$'\033[0m'
  else
    C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_PURPLE="" C_CYAN="" C_WHITE="" C_GRAY="" C_RESET=""
  fi
  # Styled Output Variables
  I_MSG="${C_PURPLE}" # Output Variable without Prefix for Standard Messages
  I_SKIP="${C_GRAY}[${C_CYAN} SKIP ${C_GRAY}]${C_RESET} "
  I_WARN="${C_GRAY}[${C_YELLOW} WARN ${C_GRAY}]${C_RESET} "
  I_OK="${C_GRAY}[${C_GREEN} OK ${C_GRAY}]${C_RESET} "
  I_INFO="${C_GRAY}[${C_PURPLE} INFO ${C_GRAY}]${C_RESET} "
  I_ERR="${C_GRAY}[${C_RED} ERROR ${C_GRAY}]${C_RESET} "
  # Styled Input Variables
  I_INPUT="${C_GRAY}[${C_BLUE}  ${C_GRAY}]${C_RESET} "
  I_ASK="${C_GRAY}[${C_BLUE} ? ${C_GRAY}]${C_RESET} "
  I_YN="${C_GRAY}[${C_BLUE} y/n ${C_GRAY}]${C_RESET} "
}

# Shared Log Wrapper for Log Functions below
_log() {
  local style=$1
  shift
  printf '%s%s%s\n' "$style" "$*" "$C_RESET"
}

# Shared Input Wrapper for Prompts with user-input below
# _input [-s] <style> <var_name> <message...>   (-s: hidden input, e.g. for secrets)
_input() {
  local __input_silent=""
  if [[ ${1-} == -s ]]; then
    __input_silent=1
    shift
  fi
  local __input_style=$1 __input_var=$2 __input_rc=0
  shift 2
  printf '%s%s%s ' "$__input_style" "$*" "$C_RESET" >&2
  # Store User Input in the Variable named by the caller
  if [[ -n $__input_silent ]]; then
    IFS= read -rs "${__input_var:?_input: missing variable name}" || __input_rc=$?
    printf '\n' >&2 # hidden input: the Enter key is not echoed
  else
    IFS= read -r "${__input_var:?_input: missing variable name}" || __input_rc=$?
  fi
  return "$__input_rc"
}

# Log Functions (Output)
log_() { _log "$I_MSG" "$@"; }
log_ok() { _log "$I_OK" "$@"; }
log_info() { _log "$I_INFO" "$@"; }
log_skip() { _log "$I_SKIP" "$@"; }
log_warn() { _log "$I_WARN" "$@" >&2; }
log_err() { _log "$I_ERR" "$@" >&2; }
# Log Functions (Input)
# Usage: input_ask var_name "Please enter X:"
input_() { _input "$I_INPUT" "$@"; }
input_ask() { _input "$I_ASK" "$@"; }
input_yn() { _input "$I_YN" "$@"; }
input_secret() { _input -s "$I_ASK" "$@"; }

tty_styles

die() {
  log_err "$@"
  exit 1
}

# run CMD...: execute, or only print it with --dry-run.
# stderr: callers send the command's own output to /dev/null.
run() { if [ "$DRY" -eq 1 ]; then log_skip "dry-run: $*" >&2; else "$@"; fi; }

# ask QUESTION: y/n on the terminal. --yes answers yes, --dry-run and no terminal answer no.
ask() {
  local answer=""
  if [ "$DRY" -eq 1 ]; then
    log_skip "dry-run: would ask: $1"
    return 1
  fi
  [ "$YES" -eq 1 ] && return 0
  { : </dev/tty; } 2>/dev/null || return 1
  # Prompt and answer on the terminal, even when stdin is a pipe (curl | bash) or stderr is redirected.
  input_yn answer "$1" </dev/tty 2>/dev/tty || return 1
  case "$answer" in y | Y | yes) return 0 ;; *) return 1 ;; esac
}

# tu ARGS...: tuios, optionally against a separate daemon (ONEAI_TUIOS_SERVER, used by the tests).
tu() { if [ -n "${ONEAI_TUIOS_SERVER:-}" ]; then tuios --server "$ONEAI_TUIOS_SERVER" "$@"; else tuios "$@"; fi; }
have() { command -v "$1" >/dev/null 2>&1; }
slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//' | cut -c1-40; }

# project_from DIR: sets ROOT (this checkout), MAIN (main checkout), SESSION (TUIOS session name).
project_from() {
  ROOT="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository: $1"
  MAIN="$(git -C "$ROOT" worktree list --porcelain | sed -n '1s/^worktree //p')"
  SESSION="$(basename "$MAIN" | sed 's/[^A-Za-z0-9_-]/-/g')"
}

# ------------------------------------------------------------------ help ---

usage() {
  cat <<EOF
oneai $ONEAI_VERSION: Jarvis + side agents for Claude Code, TUIOS and Worktrunk.

Usage:
  oneai [options] [REPO]             Set up the global layer and REPO (default: .), open its TUIOS session
  oneai global [--dry-run] [--yes]   Only the global layer (install.sh runs this)
  oneai side [--model M] BRANCH PROMPT
                                     Start a side agent: new Worktrunk worktree + Claude Code
                                     on TUIOS workspace 4 (limit: ONEAI_SIDE_MAX, default 1)
  oneai metrics log|summary|sessions See 'oneai metrics --help'

Options:
  --dry-run     Show what would happen, change nothing
  --uninstall   Remove what oneai created in REPO and in the global layer
  --yes         Answer yes to every question (edited files are still kept as .oneai-bak)
  --no-attach   Don't attach to the TUIOS session
  -h, --help    This help;  -V, --version

What setup writes (never overwrites silently):
  Global layer (\$CLAUDE_CONFIG_DIR = $CLAUDE_CFG): all pending changes shown as diffs,
  applied after one question, symlinked files written through (they stay links):
    agents/explorer.md, output-reader.md, test-writer.md, doc-writer.md
    CLAUDE.md: the block between "<!-- oneai:begin workflow" and "<!-- oneai:end workflow -->"
    settings.json: only permissions.additionalDirectories gets Worktrunk's worktree dir
      (static part of worktree-path, e.g. ~/dev/worktrees; override: ONEAI_WORKTREES_DIR)
  Project layer (REPO):
    CLAUDE.md, justfile, .claude/settings.json, .claude/hooks/{checks,format,stop-check}.sh,
    .config/wt.toml, .worktreeinclude, STATE.md (main checkout), .mcp.json (frontends only),
    missing .gitignore lines
    Files you edit (CLAUDE.md, STATE.md, justfile, settings.json, checks.sh, wt.toml,
    .worktreeinclude) are only created when missing. format.sh, stop-check.sh and .mcp.json
    are kept in sync with the templates: differences are shown as a diff and asked about.
  Every created file carries the marker "$MARKER" (except JSON: compared with the template).
  --uninstall deletes unchanged ones and moves edited ones to <file>.oneai-bak.

TUIOS session (named after the repo):
  1 Coding      lazygit / shell | nvim (70%)
  2 Jarvis      Claude Code (70%) | STATE.md live / wt list live
  3 Logstream   two shells, 50/50
  4 Side agents panes started with 'oneai side'

Worktree trust: Claude Code keys trust on the main checkout's root, so worktrees of a
trusted repo need no extra trust entry. oneai never writes ~/.claude.json.

Environment: CLAUDE_CONFIG_DIR, ONEAI_SHARE (templates), ONEAI_SIDE_MAX,
ONEAI_TUIOS_SERVER (separate tuios daemon, for tests).
EOF
}

# ------------------------------------------------------------------ deps ---

cmd_deps() {
  local t req="" opt=""
  for t in git claude tuios wt jq just; do have "$t" || req="$req $t"; done
  for t in lazygit nvim glow shellcheck shfmt; do have "$t" || opt="$opt $t"; done
  [ -z "$opt" ] || log_warn "missing (recommended):$opt  ->  brew install$opt"
  [ -z "$req" ] || die "missing (required):$req"
  log_ok "required tools found"

  if tuios integration status claude-code 2>&1 | grep -q 'installed, current'; then
    log_ok "TUIOS Claude Code integration installed"
  else
    log_warn "TUIOS Claude Code integration missing or outdated: questions and approvals won't reach the Inbox"
    if ask "Run 'tuios integration install claude-code --statusline' now?"; then
      run tuios integration install claude-code --statusline || log_warn "install failed"
    fi
  fi
  if jq -e '.enabledPlugins["worktrunk@worktrunk"] == true' "$CLAUDE_CFG/settings.json" >/dev/null 2>&1; then
    log_ok "Worktrunk Claude Code plugin enabled"
  else
    log_warn "Worktrunk Claude Code plugin not enabled (activity in 'wt list'): see worktrunk.dev, then 'claude plugin install worktrunk@worktrunk'"
  fi
}

# ----------------------------------------------------------------- files ---

# place_file RENDERED TARGET: create, or show a diff and ask when different.
# cp writes through symlinks, so a linked target stays a link.
place_file() {
  local rel="${2/#"$HOME"/\~}"
  if [ ! -e "$2" ]; then
    if [ "$DRY" -eq 1 ]; then
      log_skip "dry-run: would create $rel"
      return 0
    fi
    mkdir -p "$(dirname "$2")"
    cp "$1" "$2"
    log_ok "created $rel"
    CHANGED="$CHANGED $rel"
  elif ! cmp -s "$1" "$2"; then
    log_info "$rel differs from the oneai template:"
    diff -u "$2" "$1" | sed -n '3,200p' >&2 || true
    if ask "Replace $rel with the template (yours is kept as $rel.oneai-bak)?"; then
      run cp "$2" "$2.oneai-bak"
      run cp "$1" "$2"
      log_ok "updated $rel"
      CHANGED="$CHANGED $rel"
    else
      log_info "kept your $rel"
    fi
  fi
}

# drop_file RENDERED TARGET: --uninstall for one file.
drop_file() {
  local rel="${2/#"$HOME"/\~}"
  [ -e "$2" ] || return 0
  if cmp -s "$1" "$2"; then
    run rm "$2" && log_ok "removed $rel"
  elif grep -q "$MARKER" "$2" 2>/dev/null; then
    log_info "$rel was edited since oneai created it:"
    diff -u "$1" "$2" | sed -n '3,60p' >&2 || true
    if ask "Remove it anyway (moved to $rel.oneai-bak)?"; then run mv "$2" "$2.oneai-bak" && log_ok "moved $rel to $rel.oneai-bak"; fi
  else
    log_info "kept $rel (not created by oneai)"
  fi
}

is_frontend() {
  [ -f "$1/package.json" ] && jq -e '[(.dependencies // {}), (.devDependencies // {})] | add // {} | keys[]
    | select(test("^(svelte|@sveltejs/kit|react|vue|nuxt|next|astro|solid-js|@angular/core|vite|preact|lit)$"))' \
    "$1/package.json" >/dev/null 2>&1
}

# ---------------------------------------------------------- global layer ---

# Static part of Worktrunk's worktree-path when it is outside the repos (e.g. ~/dev/worktrees).
worktrees_dir() {
  local tpl prefix
  [ -z "${ONEAI_WORKTREES_DIR:-}" ] || {
    printf '%s' "$ONEAI_WORKTREES_DIR"
    return
  }
  tpl="$(sed -n 's/^worktree-path *= *"\(.*\)"$/\1/p' "${XDG_CONFIG_HOME:-$HOME/.config}/worktrunk/config.toml" 2>/dev/null | head -n 1)"
  prefix="${tpl%%\{\{*}"
  prefix="${prefix%/}"
  # shellcheck disable=SC2088 # a literal ~/ prefix is wanted: settings.json expands it
  case "$prefix" in "~/"?* | /?*) printf '%s' "$prefix" ;; esac
}

# with_block FILE ADD: FILE with oneai's CLAUDE.md block replaced in place,
# appended when missing (ADD=1), or removed (ADD=0). A copy of the block's text
# without the markers (pasted by hand) gets wrapped instead of duplicated.
# Markers match by prefix, so rewording their comment text never duplicates the block.
# A begin marker without an end marker leaves the file unchanged (exit 3).
# Everything else is untouched. A missing FILE counts as empty.
BLOCK_BEGIN="<!-- oneai:begin workflow"
BLOCK_END="<!-- oneai:end workflow"
with_block() {
  local blk="$SHARE/global/CLAUDE.workflow.md" file="$1"
  [ -e "$file" ] || file=/dev/null
  awk -v blk="$blk" -v add="$2" -v b="$BLOCK_BEGIN" -v en="$BLOCK_END" '
    BEGIN { while ((getline l < blk) > 0) want[++nb] = l; close(blk) }
    function put(  k) { for (k = 1; k <= nb; k++) print want[k] }
    { f[++n] = $0 }
    END {
      s = 0
      for (i = 1; i <= n; i++) if (index(f[i], b) == 1) { s = i; break }
      if (s) {
        for (e = s; e <= n && index(f[e], en) != 1; e++);
        if (e > n) { for (i = 1; i <= n; i++) print f[i]; exit 3 }
      } else if (add) {   # unmarked copy of the body?
        for (i = 1; i + nb - 3 <= n && !s; i++) {
          for (k = 2; k < nb && f[i + k - 2] == want[k]; k++);
          if (k == nb) { s = i; e = i + nb - 3 }
        }
      }
      for (i = 1; i <= n; i++) {
        if (s && i == s) { if (add) put(); i = e; continue }
        print f[i]
      }
      if (!s && add) { if (n > 0) print ""; put() }
    }' "$file"
}

# global_render DIR: write the desired global files to DIR; print "RENDERED<TAB>TARGET" per file.
global_render() {
  local out="$1" f dir cur="$CLAUDE_CFG/settings.json"
  for f in "$SHARE"/global/agents/*.md; do printf '%s\t%s\n' "$f" "$CLAUDE_CFG/agents/$(basename "$f")"; done
  if with_block "$CLAUDE_CFG/CLAUDE.md" 1 >"$out/CLAUDE.md"; then
    printf '%s\t%s\n' "$out/CLAUDE.md" "$CLAUDE_CFG/CLAUDE.md"
  else
    log_warn "$CLAUDE_CFG/CLAUDE.md has '$BLOCK_BEGIN' but no '$BLOCK_END' line: left unchanged, fix it by hand"
  fi
  dir="$(worktrees_dir)"
  [ -n "$dir" ] || return 0
  [ -e "$cur" ] || cur=/dev/null
  # Only permissions.additionalDirectories changes; hooks and statusLine (tuios) stay as they are.
  # "~/x" and "$HOME/x" are the same entry.
  if jq -s --arg d "$dir" --arg home "$HOME" '(.[0] // {}) | .permissions.additionalDirectories =
      ((.permissions.additionalDirectories // []) | ($d | sub("^~"; $home)) as $abs
        | if any(.[]; sub("^~"; $home) == $abs) then . else . + [$d] end)' "$cur" >"$out/settings.json"; then
    printf '%s\t%s\n' "$out/settings.json" "$CLAUDE_CFG/settings.json"
  else
    log_warn "$CLAUDE_CFG/settings.json is not valid JSON: add \"$dir\" to permissions.additionalDirectories yourself"
  fi
}

# setup_global: show every pending change to $CLAUDE_CFG as a diff, apply all after one question.
# Writes with `cat >` so symlinked files (dotfiles) stay links.
setup_global() {
  local tmp rendered target pending=()
  tmp="$(mktemp -d)"
  : >"$tmp/none" # diff base for new files (some sandboxes refuse diff on /dev/null)
  while IFS=$'\t' read -r rendered target; do
    cmp -s "$rendered" "$target" 2>/dev/null && continue
    pending+=("$rendered" "$target")
    log_info "${target/#"$HOME"/\~}:"
    diff -u "$([ -e "$target" ] && printf '%s' "$target" || printf '%s' "$tmp/none")" "$rendered" | sed -n '3,80p' >&2 || true
  done < <(global_render "$tmp")
  if [ "${#pending[@]}" -eq 0 ]; then
    log_ok "global config in $CLAUDE_CFG is up to date"
  elif ask "Apply these $((${#pending[@]} / 2)) change(s) to $CLAUDE_CFG (existing files backed up as *.oneai-bak)?"; then
    set -- "${pending[@]}"
    while [ $# -gt 0 ]; do
      [ ! -e "$2" ] || cp "$2" "$2.oneai-bak"
      mkdir -p "$(dirname "$2")"
      cat "$1" >"$2"
      log_ok "wrote ${2/#"$HOME"/\~}"
      shift 2
    done
  else
    log_info "global config left as it is"
  fi
  rm -rf "$tmp"
}

uninstall_global() {
  local f tmp
  for f in "$SHARE"/global/agents/*.md; do drop_file "$f" "$CLAUDE_CFG/agents/$(basename "$f")"; done
  if grep -q "^$BLOCK_BEGIN" "$CLAUDE_CFG/CLAUDE.md" 2>/dev/null &&
    ask "Remove oneai's workflow block from ${CLAUDE_CFG/#"$HOME"/\~}/CLAUDE.md?"; then
    tmp="$(mktemp)"
    if with_block "$CLAUDE_CFG/CLAUDE.md" 0 >"$tmp"; then
      cp "$CLAUDE_CFG/CLAUDE.md" "$CLAUDE_CFG/CLAUDE.md.oneai-bak"
      cat "$tmp" >"$CLAUDE_CFG/CLAUDE.md"
      log_ok "removed the workflow block (backup: CLAUDE.md.oneai-bak)"
    else
      log_warn "CLAUDE.md has '$BLOCK_BEGIN' but no '$BLOCK_END' line: left unchanged, remove the block by hand"
    fi
    rm -f "$tmp"
  fi
  log_info "kept permissions.additionalDirectories in settings.json (remove the worktrees entry yourself if unwanted)"
}

# --------------------------------------------------------- project files ---

# each_file FN: call FN RENDERED TARGET for every project file.
each_file() {
  local fn="$1" rel target out tmp
  tmp="$(mktemp -d)"
  while IFS= read -r rel; do
    target="$rel"
    if [ "$rel" = STATE.template.md ]; then
      [ "$ROOT" = "$MAIN" ] || continue
      target=STATE.md # shipped renamed: many global gitignores skip STATE.md
    fi
    out="$tmp/$rel"
    mkdir -p "$(dirname "$out")"
    sed "s|{{PROJECT}}|$(basename "$MAIN")|g" "$SHARE/templates/$rel" >"$out"
    case "$rel" in *.sh) chmod +x "$out" ;; esac
    "$fn" "$out" "$ROOT/$target"
  done < <(cd "$SHARE/templates" && find . -type f | sed 's|^\./||' | sort)
  if is_frontend "$ROOT"; then "$fn" "$SHARE/optional/mcp.json" "$ROOT/.mcp.json"; fi
  rm -rf "$tmp"
}

# Files the project and Jarvis are meant to edit: created when missing, never offered for
# replacement, so a daily `oneai REPO` neither asks about them nor touches lessons or state.
SEED_FILES=" CLAUDE.md STATE.md justfile .claude/settings.json .claude/hooks/checks.sh .config/wt.toml .worktreeinclude "
place_project() {
  case "$SEED_FILES" in *" ${2#"$ROOT"/} "*) [ -e "$2" ] && return 0 ;; esac
  place_file "$@"
}

setup_files() {
  [ -d "$SHARE/templates" ] || die "templates not found in $SHARE (set ONEAI_SHARE)"
  CHANGED=""
  each_file place_project

  local line missing="" nl=""
  while IFS= read -r line; do
    case "$line" in "" | "#"*) continue ;; esac
    grep -qxF "$line" "$ROOT/.gitignore" 2>/dev/null || missing="$missing$line"$'\n'
  done <"$SHARE/gitignore.lines"
  if [ -n "$missing" ]; then
    log_info ".gitignore lacks:"
    printf '%s' "$missing" | sed 's/^/    /' >&2
    if ask "Append them to .gitignore?"; then
      if [ "$DRY" -eq 0 ]; then
        [ ! -s "$ROOT/.gitignore" ] || [ -z "$(tail -c1 "$ROOT/.gitignore")" ] || nl=$'\n'
        printf '%s# oneai: personal and per-checkout files\n%s' "$nl" "$missing" >>"$ROOT/.gitignore"
      fi
      log_ok "updated .gitignore"
    fi
  fi

  if [ -n "$CHANGED" ]; then
    log_warn "commit the new project files, so side agents' worktrees (branched from the default branch) get them"
  fi
  # Only right after creating wt.toml; later changes make Worktrunk ask by itself.
  if [[ $CHANGED == *.config/wt.toml* ]] && have wt; then
    log_info "Worktrunk asks once per repo before running the project hooks in .config/wt.toml."
    if ask "Approve them now ('wt config approvals add')?"; then run wt -C "$ROOT" config approvals add || log_warn "approval failed"; fi
  fi
}

cmd_uninstall() {
  [ -d "$SHARE/templates" ] || die "templates not found in $SHARE (set ONEAI_SHARE)"
  log_info "removing what oneai created in $ROOT and $CLAUDE_CFG (edited files only after asking)"
  each_file drop_file
  uninstall_global
  log_info "kept: .gitignore lines, .claude/metrics.csv, STATE-archive.md, the TUIOS session and integrations"
}

# --------------------------------------------------------------- session ---

session_exists() { tu ls --json 2>/dev/null | jq -e --arg n "$1" 'any(.[]?; .name == $n)' >/dev/null 2>&1; }

new_win() { # NAME WORKSPACE [-- CMD...]
  local n="$1" w="$2"
  shift 2
  run tu new-window "$n" --workspace "$w" -s "$SESSION" --cwd "$MAIN" --no-focus "$@" >/dev/null
}
split_win() { # TARGET DIRECTION RATIO NAME [-- CMD...]
  local t="$1" dir="$2" r="$3" n="$4"
  shift 4
  run tu split-window "$dir" -w "$t" -s "$SESSION" --ratio "$r" --name "$n" --cwd "$MAIN" --no-focus "$@" >/dev/null
}
prog() { if have "$1"; then printf -- '-- %s' "$1"; fi; } # "-- PROGRAM" if installed, else a shell

create_session() {
  local first env=()
  log_info "creating TUIOS session '$SESSION'"
  run tu new "$SESSION" --detach --cwd "$MAIN" >/dev/null
  first=""
  [ "$DRY" -eq 1 ] || first="$(tu list-windows -s "$SESSION" --json | jq -r '.windows[0].window_id // empty')"
  [ -z "${ONEAI_TUIOS_SERVER:-}" ] || env=(env "ONEAI_TUIOS_SERVER=$ONEAI_TUIOS_SERVER")

  # 1 Coding: lazygit (top-left) / shell (bottom-left) | nvim (right 70%)
  # shellcheck disable=SC2046 # prog prints "-- PROGRAM" or nothing, split on purpose
  new_win lazygit 1 $(prog lazygit)
  [ -z "$first" ] || run tu close-window "$first" -s "$SESSION" >/dev/null
  # shellcheck disable=SC2046
  split_win lazygit right 70 nvim $(prog nvim)
  split_win lazygit down 50 shell
  run tu set-workspace-name 1 Coding -s "$SESSION" >/dev/null

  # 2 Jarvis: Claude Code (70%) | STATE.md live (top) / wt list live (bottom)
  run tu start-agent claude -s "$SESSION" --workspace 2 --cwd "$MAIN" --name jarvis --no-wait >/dev/null ||
    log_warn "could not start Claude Code on workspace 2"
  split_win jarvis right 30 state -- "${env[@]}" "$SELF" _watch state "$MAIN"
  split_win state down 50 worktrees -- "${env[@]}" "$SELF" _watch wt "$MAIN"
  run tu set-workspace-name 2 Jarvis -s "$SESSION" >/dev/null

  # 3 Logstream: two shells, 50/50
  new_win logs-left 3
  split_win logs-left right 50 logs-right
  run tu set-workspace-name 3 Logstream -s "$SESSION" >/dev/null

  # 4 Side agents: 'oneai side' opens its panes here
  run tu set-workspace-name 4 "Side agents" -s "$SESSION" >/dev/null || true

  run tu select-workspace 2 -s "$SESSION" >/dev/null
  log_ok "session '$SESSION' ready"
}

open_session() {
  if session_exists "$SESSION"; then log_ok "session '$SESSION' exists"; else create_session; fi
  [ "$ATTACH" -eq 1 ] && [ "$DRY" -eq 0 ] || return 0
  if [ -n "${TUIOS_SESSION:-}" ]; then tu switch-session "$SESSION"; else exec tuios attach "$SESSION"; fi
}

# _watch state|wt DIR: token-free live panes on the Jarvis workspace.
cmd_watch() {
  local what="$1" dir="$2" last="" now
  while :; do
    if [ "$what" = state ]; then
      now="$(cat "$dir/STATE.md" 2>/dev/null || echo "no STATE.md yet")"
      if [ "$now" != "$last" ]; then
        clear
        if have glow; then printf '%s\n' "$now" | glow -; else printf '%s\n' "$now"; fi
        last="$now"
      fi
      sleep 2
    else
      now="$(wt -C "$dir" list 2>&1)"
      clear
      printf '%s\n\nProgress of a side agent: tuios agent-log -w side-<slug> --recap\n' "$now"
      sleep 5
    fi
  done
}

# ------------------------------------------------------------------ side ---

side_panes() { tu list-windows -s "$SESSION" --json 2>/dev/null | jq '[.windows[]? | select((.name // "") | startswith("side-"))] | length'; }

cmd_side() {
  local model="" branch="" prompt="" slug max active
  while [ $# -gt 0 ]; do
    case "$1" in
      --model)
        model="$2"
        shift 2
        ;;
      -h | --help)
        usage
        return 0
        ;;
      -*) die "unknown option: $1" ;;
      *)
        if [ -z "$branch" ]; then branch="$1"; elif [ -z "$prompt" ]; then prompt="$1"; else die "too many arguments"; fi
        shift
        ;;
    esac
  done
  [ -n "$branch" ] && [ -n "$prompt" ] || die "usage: oneai side [--model M] BRANCH PROMPT"
  project_from .
  max="${ONEAI_SIDE_MAX:-1}"
  active="$(side_panes || echo 0)"
  [ "${active:-0}" -lt "$max" ] || die "$active side agent pane(s) open, limit $max (ONEAI_SIDE_MAX). Close a finished one: tuios close-window side-<slug>"
  slug="side-$(slugify "$branch")"
  local launch=(wt switch --create "$branch" -x claude --)
  [ -z "$model" ] || launch+=(--model "$model")
  launch+=(-n "$slug" "$prompt")
  new_win "$slug" 4 -- "${launch[@]}"
  log_ok "side agent '$slug' started on workspace 4 (branch $branch)"
  log_info "track: wt list   |   tuios agent-log -w $slug --recap"
}

# --------------------------------------------------------------- metrics ---

METRICS_HEADER='task,date,who,model,effort,minutes,input_tokens,output_tokens,cache_read_tokens,cache_write_tokens,cost_usd,interventions,rework_rounds,verify_first_try,sessions,notes'

# Claude Code keeps transcripts in projects/<path with every non-alphanumeric as '-'>.
transcripts_of() { # DIR: main transcripts of a checkout path, newest first
  local p d
  for p in "$1" "$(cd "$1" 2>/dev/null && pwd -P)"; do
    d="$CLAUDE_CFG/projects/$(printf '%s' "$p" | sed 's/[^A-Za-z0-9]/-/g')"
    if [ -d "$d" ]; then ls -t "$d"/*.jsonl 2>/dev/null || true; fi
  done | awk '!seen[$0]++'
}

jqfiles() { # LIST FILTER...: jq -s over newline-separated files
  local l="$1"
  shift
  printf '%s\n' "$l" | tr '\n' '\0' | xargs -0 jq -s "$@"
}

# metrics_row FILES TASK WHO EFFORT END COST INTERV REWORK VERIFY NOTES -> CSV row
metrics_row() {
  local files="$1" subs all tokens main start minutes interv ids
  subs="$(printf '%s\n' "$files" | while IFS= read -r f; do
    if [ -d "${f%.jsonl}/subagents" ]; then find "${f%.jsonl}/subagents" -name '*.jsonl'; fi
  done)"
  all="$files${subs:+$'\n'$subs}"
  tokens="$(jqfiles "$all" -r '
    [.[] | select(.type == "assistant" and .message.usage != null and .message.model != "<synthetic>")]
    | unique_by(.message.id // .uuid)
    | [map(.message.usage.input_tokens // 0), map(.message.usage.output_tokens // 0),
       map(.message.usage.cache_read_input_tokens // 0), map(.message.usage.cache_creation_input_tokens // 0)]
    | map(add // 0 | tostring) | join(",")')"
  # shellcheck disable=SC2016 # jq program, not shell
  main="$(jqfiles "$files" '
    def ts: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    ([.[] | select(.type == "user" and .origin.kind == "human" and (.isSidechain | not))] | unique_by(.uuid)) as $h
    | {start: ($h | map(.timestamp | ts) | min), humans: ($h | length),
       model: ([.[] | select(.type == "assistant" and (.isSidechain | not)) | .message.model
                | select(. != null and . != "<synthetic>")] | group_by(.) | sort_by(-length) | map(.[0]) | join("+"))}')"
  start="$(printf '%s' "$main" | jq -r '.start // empty')"
  [ -n "$start" ] || {
    log_warn "no human prompt in the transcript(s)"
    return 1
  }
  minutes="$(jq -n --argjson s "$start" --argjson e "$5" '(($e - $s) / 60 * 10 | round) / 10')"
  interv="$7"
  [ -n "$interv" ] || interv="$(printf '%s' "$main" | jq '[.humans - 1, 0] | max')"
  ids="$(printf '%s\n' "$files" | while IFS= read -r f; do basename "$f" .jsonl; done | paste -sd ';' -)"
  clean() { printf '%s' "$1" | tr ',"\n' ";' "; }
  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$(clean "$2")" "$(date +%F)" "$3" \
    "$(printf '%s' "$main" | jq -r .model)" "$4" "$minutes" "$tokens" "$6" "$interv" "$8" "$9" "$ids" "$(clean "${10}")"
}

metrics_help() {
  cat <<'EOF'
oneai metrics log [options] TASK   Append one row to <main checkout>/.claude/metrics.csv
  --who jarvis|side|plain  who did the task (default: jarvis; plain = baseline session)
  --effort LEVEL           effort used (low|medium|high|xhigh|max)
  --dir PATH               checkout whose transcripts to read (side agent: its worktree,
                           before 'wt merge' removes it; default: this checkout)
  -s, --session ID|FILE    transcript(s) to read, repeatable (default: newest in --dir)
  --merged REF|now         end time (default: HEAD's commit time)
  --cost USD  --rework N  --verify y|n  --interventions N  --notes TEXT
  Tokens, model, minutes and (unless given) interventions come from the transcript.
oneai metrics summary              Averages per 'who'
oneai metrics sessions [--dir P]   Recent sessions of a checkout
EOF
}

cmd_metrics() {
  local sub="${1:-}" who=jarvis effort="" dir="" merged=HEAD cost="" rework="" verify="" interv="" notes=""
  local sessions="" task="" csv files end row
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in -h | --help) ;; -*) [ $# -ge 2 ] || die "$1 needs a value" ;; esac
    case "$1" in
      -s | --session) sessions="${sessions:+$sessions$'\n'}$2" ;;
      --who) who="$2" ;;
      --effort) effort="$2" ;;
      --dir) dir="$2" ;;
      --merged) merged="$2" ;;
      --cost) cost="$2" ;;
      --rework) rework="$2" ;;
      --verify) verify="$2" ;;
      --interventions) interv="$2" ;;
      --notes) notes="$2" ;;
      -h | --help)
        metrics_help
        return 0
        ;;
      -*) die "unknown option: $1" ;;
      *)
        task="$1"
        shift
        continue
        ;;
    esac
    shift 2
  done
  project_from "${dir:-.}"
  csv="$MAIN/.claude/metrics.csv"
  case "$sub" in
    log)
      [ -n "$task" ] || die "usage: oneai metrics log [options] TASK"
      case "$who" in jarvis | side | plain) ;; *) die "--who must be jarvis, side or plain" ;; esac
      case "$verify" in y | n | "") ;; *) die "--verify must be y or n" ;; esac
      if [ -z "$sessions" ]; then
        files="$(transcripts_of "$ROOT" | head -n 1)"
      else
        files="$(printf '%s\n' "$sessions" | while IFS= read -r s; do
          if [ -f "$s" ]; then printf '%s\n' "$s"; else find "$CLAUDE_CFG/projects" -maxdepth 2 -name "$s.jsonl" | head -n 1; fi
        done)"
      fi
      [ -n "$files" ] || die "no transcript found; pass --session ID or --dir"
      if [ "$merged" = now ]; then end="$(date +%s)"; else end="$(git -C "$ROOT" log -1 --format=%ct "$merged")"; fi
      row="$(metrics_row "$files" "$task" "$who" "$effort" "$end" "$cost" "$interv" "$rework" "$verify" "$notes")"
      if [ "$DRY" -eq 1 ]; then
        log_skip "dry-run: $row"
        return 0
      fi
      mkdir -p "$(dirname "$csv")"
      [ -s "$csv" ] || printf '%s\n' "$METRICS_HEADER" >"$csv"
      printf '%s\n' "$row" >>"$csv"
      printf '%s\n' "$row"
      ;;
    summary)
      [ -s "$csv" ] || die "no data in $csv"
      jq -Rrs '
        split("\n") | map(select(length > 0)) | .[1:] | map(split(",")) | group_by(.[2])[]
        | {who: .[0][2], n: length,
           min: (map(.[5] | tonumber? // empty) | add / length),
           tok: (map((.[6] | tonumber? // 0) + (.[7] | tonumber? // 0) + (.[9] | tonumber? // 0)) | add / length),
           cost: (map(.[10] | tonumber? // empty) | if length > 0 then add / length else null end),
           intv: (map(.[11] | tonumber? // empty) | add / length),
           rew: (map(.[12] | tonumber? // empty) | if length > 0 then add / length else null end),
           vfy: (map(select(.[13] == "y")) | length)}
        | "\(.who): \(.n) tasks | \(.min * 10 | round / 10) min | \(.tok | round) tokens (in+out+cache-write) | cost \(.cost // "-") | interventions \(.intv * 10 | round / 10) | rework \(.rew // "-") | verify first try \(.vfy)/\(.n)"' "$csv"
      ;;
    sessions)
      transcripts_of "$ROOT" | head -n 10 | while IFS= read -r f; do
        jq -rs --arg f "$(basename "$f" .jsonl)" '[.[] | select(.type == "user" and .origin.kind == "human")] as $h
          | "\($f)  \($h[0].timestamp // "-")  \(($h[0].message.content // "" | tostring | gsub("\\s+"; " "))[0:60])"' "$f"
      done
      ;;
    *) metrics_help ;;
  esac
}

# ------------------------------------------------------------------ main ---

main() {
  local cmd=setup repo=.
  case "${1:-}" in
    side)
      shift
      cmd_side "$@"
      return
      ;;
    metrics)
      shift
      cmd_metrics "$@"
      return
      ;;
    _watch)
      shift
      cmd_watch "$@"
      return
      ;;
    global)
      shift
      cmd=global
      ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1 ;;
      --yes) YES=1 ;;
      --no-attach) ATTACH=0 ;;
      --uninstall) cmd=uninstall ;;
      -h | --help)
        usage
        return 0
        ;;
      -V | --version)
        echo "oneai $ONEAI_VERSION"
        return 0
        ;;
      -*) die "unknown option: $1 (see oneai --help)" ;;
      *) repo="$1" ;;
    esac
    shift
  done
  if [ "$cmd" = global ]; then
    setup_global
    return
  fi
  project_from "$repo"
  if [ "$cmd" = uninstall ]; then
    cmd_uninstall
    return
  fi
  [ "$ROOT" = "$MAIN" ] || log_warn "$ROOT is a worktree; STATE.md and the session belong to $MAIN"
  cmd_deps
  setup_global
  setup_files
  open_session
}

main "$@"
